# Supabase project that stores the rooms (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
# Anon key: only used in the browser to listen to room broadcasts. RLS denies it
# every table, so it cannot read or write room data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, used by the route handlers under /api/rooms.
# Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: route OCR through the server-side Google Vision provider instead of
# on-device Tesseract. Requires GOOGLE_VISION_API_KEY.
# NEXT_PUBLIC_OCR_PROVIDER=google-vision
# GOOGLE_VISION_API_KEY=
